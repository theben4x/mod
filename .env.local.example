# ───────────────────────────────────────────────────────────
# mod — משתני סביבה
# העתק קובץ זה ל-.env.local ומלא את הערכים. כל המשתנים אופציונליים:
# ללא הגדרה, האתר משתמש במחירי seed מקומיים (₪/$).
# ───────────────────────────────────────────────────────────

# כתובת בסיס האתר (לשימוש ב-SEO / sitemap / OG / קישורים מוחלטים)
NEXT_PUBLIC_SITE_URL=https://mod.co.il

# ── שכבת המחירים (pluggable) ──
# אם מוגדר, /api/price ינסה לשלוף מחירים חיים מהמקור הזה.
# נכשל? המערכת נופלת אוטומטית למחירי seed מקומיים (graceful fallback).
#
# PRICE_PROVIDER: seed | http   (ברירת מחדל: seed)
PRICE_PROVIDER=seed
#
# עבור PRICE_PROVIDER=http:
#   המערכת תבצע GET ל-  ${PRICE_API_URL}?ids=id1,id2  עם הכותרת Authorization: Bearer ${PRICE_API_KEY}
#   ותצפה לתשובת JSON בפורמט:
#   { "id1": { "ils": 6499, "usd": 1699, "updatedAt": "2026-06-07T10:00:00Z", "url": "..." }, ... }
# PRICE_API_URL=https://your-price-source.example/api/prices
# PRICE_API_KEY=your-secret-key-here

# שער המרה לגיבוי כאשר חסר מחיר באחד המטבעות (1 USD = X ILS)
NEXT_PUBLIC_USD_TO_ILS=3.72
